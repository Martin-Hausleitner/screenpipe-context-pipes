{
  "version": 1,
  "profile": "martin-public-screenpipe-config",
  "privacy": {
    "manifestType": "derived-public-config",
    "rawDataIncluded": false,
    "absoluteLocalPathsIncluded": false,
    "tokensIncluded": false,
    "transcriptsIncluded": false,
    "localAquaTranscriptExportSupported": true,
    "meetingAudioRecordingsIncluded": false,
    "browserPrivateModeWritesAllowed": false
  },
  "audioCapturePolicy": {
    "mode": "single-audio-recorder",
    "priority": ["meetily", "aqua", "screenpipe"],
    "screenpipeWhenMeetilyActive": "fallback-and-context-only",
    "screenpipeWhenAquaActive": "fallback-only",
    "screenpipeWhenNeitherActive": "primary-fallback",
    "publicTranscriptPolicy": "no transcript text or raw audio in public config"
  },
  "browserPrivacyPolicy": {
    "mode": "private-browser-kill-switch",
    "signals": ["cognitor", "cloakbrowser", "incognito", "inprivate", "private browsing", "private window"],
    "privateEventHandling": "drop-private-browser-events",
    "memoryWritesWhenPrivate": "blocked",
    "screenpipeRecordHardening": [
      "--ignored-windows ::Incognito",
      "--ignored-windows ::InPrivate",
      "--ignored-windows ::Private Browsing",
      "--ignored-windows ::Private Window",
      "--ignored-windows ::Cognitor",
      "--ignored-windows CloakBrowser::",
      "--disable-clipboard-capture",
      "--disable-keyboard-capture"
    ]
  },
  "localConnectors": [
    {
      "id": "context-hub",
      "status": "installed-local",
      "purpose": "Summarize local metadata into Screenpipe memories",
      "sources": ["activitywatch", "whoop", "youtube", "aqua", "meetily", "meeting-capture-policy", "browser-privacy-policy", "gog-calendar", "skills"]
    },
    {
      "id": "aw-importer-whoop",
      "status": "linked-public-repo",
      "url": "https://github.com/Martin-Hausleitner/aw-importer-whoop",
